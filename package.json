{
  "name": "monster-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "lab": "npm run build && node scripts/lab.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.mjs\" \"tests/**/*.mjs\" \"content/*.json\" \"public/*.{html,css,svg}\" package.json tsconfig.json playwright.config.mjs .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.mjs\" \"tests/**/*.mjs\" \"content/*.json\" \"public/*.{html,css,svg}\" package.json tsconfig.json playwright.config.mjs .prettierrc.json",
    "start": "node scripts/serve.mjs",
    "dev": "npm run build && node scripts/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
